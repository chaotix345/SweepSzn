# SweepSzn env reference. Copy to web/.env.local for local dev: cp .env.example .env.local
# Every feature SELF-DISABLES when its vars are absent — the app runs fine with none of these set.
# (No auth, no leaderboards, no push; the core draft + evaluate loop always works.)

# --- Leaderboards / Redis (Upstash) — boards 503 and rate limits no-op without these ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV aliases (either pair works; UPSTASH_* wins when both are set — see lib/redis.ts)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Auth (Google One Tap + HS256 session JWTs) — sign-in UI hidden without these ---
# AUTH_SECRET must be >= 32 chars or auth treats itself as unconfigured (lib/auth.ts).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Admin dashboard (/admin) — 404s for everyone without this ---
# Comma-separated authed uids (the g-prefixed sha256 uid, visible via /api/auth/me when signed in)
ADMIN_UIDS=

# --- Web push notifications — push prompt hidden without these ---
# Generate a pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Set automatically by Vercel (never set these locally) ---
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, NODE_ENV

# --- Script-only vars (web/scripts/*, never read by the app) ---
# BASE       target server for e2e harnesses (auth_e2e, h2h_e2e, notif_e2e)
# PROD_URL   production base URL for prod-poking harnesses
# BF_*/PC_*  backfill.ts / prod_check.ts parameters — see web/scripts/README.md
